generator client {
  provider        = "prisma-client-js"
  output          = "client/corp"
  previewFeatures = ["fullTextIndex", "fullTextSearch"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL_CORP")
}

model Adiantamento {
  Apelido_empresa         String                    @db.VarChar(30)
  Apelido_estabelecimento String                    @db.VarChar(30)
  Numero_docto            String                    @db.VarChar(11)
  Numero_contrato         String                    @db.VarChar(20)
  Codigo_agentes          String                    @db.VarChar(14)
  Codigo_TipoDoc          String                    @db.VarChar(6)
  Data                    DateTime?                 @db.DateTime
  Moeda_simbolo           String                    @db.VarChar(3)
  saldo                   Decimal                   @db.Decimal(15, 2)
  Sistema                 String                    @db.VarChar(3)
  Usuario                 String                    @db.VarChar(25)
  pag_rec                 String                    @db.VarChar(1)
  Id_adianto              Int                       @id(clustered: false, map: "Id_adianto")
  quick_rs                Unsupported("timestamp")? @map("quick~rs")
  rowguid                 String                    @unique(map: "index_2046630334") @default(dbgenerated("newid()"), map: "DF__Adiantame__rowgu__5C229E14") @db.UniqueIdentifier

  @@unique([Apelido_empresa, Apelido_estabelecimento, Numero_docto], map: "IAdiantamentos")
}

model Administradora {
  Apelido_empresa         String                    @db.VarChar(30)
  Apelido_estabelecimento String                    @db.VarChar(30)
  Codigo                  String                    @db.VarChar(6)
  Descricao               String                    @db.VarChar(100)
  Codigo_agentes          String                    @db.VarChar(14)
  quick_rs                Unsupported("timestamp")? @map("quick~rs")
  Qtd_dias                Int                       @default(0, map: "DF__Administr__Qtd_d__66B933D3") @db.SmallInt
  codigo_tipodoc          String                    @default("", map: "DF__Administr__codig__722AE67F") @db.VarChar(6)

  @@id([Apelido_empresa, Apelido_estabelecimento, Codigo], map: "Iadministradora", clustered: false)
}

model agenda_encerramento {
  apelido_empresa         String   @db.VarChar(30)
  apelido_estabelecimento String   @db.VarChar(30)
  so_processa             Boolean?
  dias_p_tras_da_dt_atual Decimal? @db.Decimal(18, 0)

  @@id([apelido_empresa, apelido_estabelecimento], map: "PK_agenda_encerramento")
}

